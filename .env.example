APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# AUTHENTICATION

AUTH_OTP_EXPIRY_MINUTES=5
AUTH_OTP_LENGTH=6
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_INVITE_EXPIRY_HOURS=24
AUTH_TEMP_PASSWORD_LENGTH=16
AUTH_PIN_RESET_EXPIRY_MINUTES=15
AUTH_RATE_LIMIT_LOGIN=5
AUTH_RATE_LIMIT_REGISTER=5
AUTH_RATE_LIMIT_FORGOT_PASSWORD=5
SANCTUM_EXPIRATION=null
# Wallet top-up gateway: "sslcommerz" (default) or "simulated" (instant credit, ignored in production)
TOP_UP_GATEWAY=sslcommerz
# Public SSLCommerz sandbox store; register your own at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true
# Unfinished top-ups: checked with the gateway after N minutes, failed after N hours without a payment
TOP_UP_RECONCILE_AFTER_MINUTES=10
TOP_UP_EXPIRE_AFTER_HOURS=24

# SMS: "log" writes messages (OTP codes included) to the log; "twilio" sends real texts.
# A free Twilio trial can text numbers verified in the Twilio console: https://www.twilio.com/try-twilio
SMS_DRIVER=log
SMS_LOG_CHANNEL=
SMS_DEFAULT_COUNTRY_CODE=880
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Maker-checker: float issuance, fee/commission/bonus settings, reversals and commission-rate changes
# need a second staff member's approval. Always on in production; set false for a single-admin demo.
MAKER_CHECKER_ENABLED=true

# Signup bonus abuse controls: daily budget in BDT (0 = no limit) and clawback window in days
SIGNUP_BONUS_DAILY_BUDGET=0
SIGNUP_BONUS_CLAWBACK_DAYS=30

# Security hardening: SMS code for PIN logins from new devices; staff authenticator-app issuer name
DEVICE_BINDING_ENABLED=true
DEVICE_CHALLENGE_MINUTES=10
TOTP_ISSUER=WalletMS
TOTP_MAX_ATTEMPTS=5
# Admin reports: metrics range limit (days) and maximum rows per ledger export
REPORTS_MAX_DAYS=90
REPORTS_EXPORT_MAX_ROWS=50000
